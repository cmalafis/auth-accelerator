# Generated by auth-accelerator — OpenShift 4.20+ external (direct) OIDC.
# Pattern: {{ .Pattern.ID }}
#
# WARNING: applying this removes the built-in OpenShift OAuth server.
# Save a break-glass kubeconfig first:
#   {{ .Pattern.BreakGlass }}
#
# The issuer CA bundle must exist as a configmap in openshift-config first:
#   oc create configmap {{ .Env.CABundleConfigMap }} \
#     --from-file=ca-bundle.crt={{ .Env.PKI }}-pki-chain.crt -n openshift-config
#
# The console is a confidential client; its secret must exist before this reconciles:
#   oc create secret generic {{ .Env.ConsoleSecretName }} \
#     --from-literal=clientSecret=<console-client-secret> -n openshift-config
---
apiVersion: config.openshift.io/v1
kind: Authentication
metadata:
  name: cluster
spec:
  type: OIDC
  webhookTokenAuthenticator: null
  oidcProviders:
    - name: {{ .Env.ProviderName }}
      issuer:
        issuerURL: {{ .Env.IssuerURL }}
        audiences:
          - {{ .Env.ConsoleClientID }}
          - {{ .Env.CLIClientID }}
        issuerCertificateAuthority:
          name: {{ .Env.CABundleConfigMap }}
      oidcClients:
        # The web console is an in-cluster component that consumes the OIDC
        # provider as a confidential client. The CLI (oc) authenticates as a
        # public client via the oc-oidc exec plugin and is not listed here.
        - componentName: console
          componentNamespace: openshift-console
          clientID: {{ .Env.ConsoleClientID }}
          clientSecret:
            name: {{ .Env.ConsoleSecretName }}
      claimMappings:
        username:
          claim: {{ .Env.UsernameClaim }}
        groups:
          claim: {{ .Env.GroupsClaim }}
