# Generated by auth-accelerator — OpenShift 4.20+ external (direct) OIDC.
# Pattern: {{ .Pattern.ID }}
#
# WARNING: applying this removes the built-in OpenShift OAuth server.
# Save a break-glass kubeconfig first:
#   {{ .Pattern.BreakGlass }}
#
# The issuer CA bundle must exist as a configmap in openshift-config first:
#   oc create configmap {{ .Env.CABundleConfigMap }} \
#     --from-file=ca-bundle.crt=dod-pki-chain.crt -n openshift-config
---
apiVersion: config.openshift.io/v1
kind: Authentication
metadata:
  name: cluster
spec:
  type: OIDC
  webhookTokenAuthenticator: null
  oidcProviders:
    - name: {{ .Env.ProviderName }}
      issuer:
        issuerURL: {{ .Env.IssuerURL }}
        audiences:
          - {{ .Env.ConsoleClientID }}
          - {{ .Env.CLIClientID }}
        issuerCertificateAuthority:
          name: {{ .Env.CABundleConfigMap }}
      claimMappings:
        username:
          claim: {{ .Env.UsernameClaim }}
        groups:
          claim: {{ .Env.GroupsClaim }}
